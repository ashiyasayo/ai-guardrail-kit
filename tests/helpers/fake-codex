#!/usr/bin/env bash
set -euo pipefail

# 測試模型固定模擬 Codex 的 user-global plugin scope：只允許 loader 由安裝器
# 管理，project A/B 的 mode identity 僅存在各自 selector/cache，不會互相移除。
state=${AI_GUARDRAIL_TEST_STATE:?AI_GUARDRAIL_TEST_STATE is required}
mkdir -p "$state"
installed="$state/installed"
if [[ ! -e $installed ]]; then
  printf '%s\n' "${FAKE_CODEX_INITIAL_PLUGINS:-}" | sed '/^$/d' > "$installed"
fi

count_operation() {
  local operation=$1 count_file="$state/${1}.count" n=0
  [[ -f $count_file ]] && read -r n < "$count_file"
  n=$((n + 1)); printf '%s\n' "$n" > "$count_file"
  if [[ ${FAKE_CODEX_FAIL_OPERATION:-} == "$operation" || ${FAKE_CODEX_FAIL_OPERATION:-} == "$operation:$n" ]]; then
    printf 'fake codex: forced %s failure\n' "$operation" >&2; exit 42
  fi
}

[[ ${1:-} == plugin ]] || exit 2
case ${2:-} in
  list)
    count_operation list
    if [[ -n ${FAKE_CODEX_LIST_JSON:-} ]]; then printf '%s\n' "$FAKE_CODEX_LIST_JSON"; exit 0; fi
    entries=''
    while IFS= read -r plugin || [[ -n $plugin ]]; do
      [[ -z $plugin ]] && continue
      [[ -n $entries ]] && entries+=', '
      entries+="{\"pluginId\": \"$plugin\", \"name\": \"${plugin%%@*}\", \"marketplaceName\": \"${plugin#*@}\", \"installed\": true, \"enabled\": true}"
    done < "$installed"
    printf '{"installed": [%s]}\n' "$entries"
    ;;
  add|remove)
    plugin=${3:?missing plugin id}
    [[ $plugin == *@* ]] || { printf 'fake codex: plugin id must be name@marketplace\n' >&2; exit 2; }
    count_operation "$2"
    if [[ $2 == add ]]; then
      grep -Fxq "$plugin" "$installed" || printf '%s\n' "$plugin" >> "$installed"
    else
      grep -Fxv "$plugin" "$installed" > "$installed.tmp" || true
      mv "$installed.tmp" "$installed"
    fi
    ;;
  marketplace)
    [[ ${3:-} == upgrade ]] || exit 2
    count_operation upgrade
    printf '%s\n' "${4:-}" > "$state/upgrade.args"
    ;;
  *) exit 2 ;;
esac
