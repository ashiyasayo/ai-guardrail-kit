#!/usr/bin/env bash
set -euo pipefail
script_dir=$(cd "$(dirname "$0")" && pwd -P)
python_bin=${AI_GUARDRAIL_PYTHON:-}
if [[ -z $python_bin ]]; then
  if python3 -c 'import sys; raise SystemExit(sys.version_info < (3, 9))' >/dev/null 2>&1; then
    python_bin=python3
  elif python -c 'import sys; raise SystemExit(sys.version_info < (3, 9))' >/dev/null 2>&1; then
    python_bin=python
  else
    printf 'codex global installer: Python 3.9+ is required\n' >&2
    exit 1
  fi
fi
if [[ ${1:-} == --remove ]]; then
  repo=$(cd "${2:-$script_dir/..}" && pwd -P)
  export CODEX_HOME=${CODEX_HOME:-$HOME/.codex}
  "$python_bin" "$script_dir/codex-runtime-manager.py" clean-legacy
  "$script_dir/select-codex-mode" --remove --owner global-integrated-harness --scope user "$repo"
  printf 'Removed global Codex integrated-harness selector; loader remains installed.\n'
  exit 0
fi
repo=$(cd "${1:-$script_dir/..}" && pwd -P)
if [[ $# -gt 1 ]]; then
  printf 'usage: install-codex-global-integrated-harness [--remove] [repo-dir]\n' >&2
  exit 2
fi
"$script_dir/install-codex-guardrail-loader" --repo "$repo" >/dev/null
export AI_GUARDRAIL_ALLOW_DEVELOPMENT_SOURCE=1
export AI_GUARDRAIL_MANIFEST_PATH="$repo/codex/runtime-manifest.json"
export AI_GUARDRAIL_ARCHIVE_DIR="$repo/codex/runtime-archives"
"$script_dir/select-codex-mode" integrated-harness --scope user --source local --ref main --owner global-integrated-harness "$repo"
printf 'Installed global Codex integrated-harness fallback; loader is the only global plugin.\n'
