#!/usr/bin/env bash
set -euo pipefail
script_dir=$(cd "$(dirname "$0")" && pwd -P)
repo=$(cd "$script_dir/.." && pwd -P)
no_installed=0
if [[ ${1:-} == --no-installed ]]; then no_installed=1; shift; fi
[[ $# -le 1 ]] || { printf 'usage: verify-codex-global-integrated-harness [--no-installed] [repo-dir]\n' >&2; exit 2; }
[[ $# -eq 0 ]] || repo=$(cd "$1" && pwd -P)
if (( no_installed )); then
  "$script_dir/verify-codex-mode" --no-managed-mode --scope user "$repo"
  printf 'Verified no global Codex integrated-harness selector.\n'
else
  "$script_dir/verify-codex-mode" integrated-harness --scope user "$repo"
  [[ -f ${CODEX_HOME:-$HOME/.codex}/guardrail/loader/current.json ]] || { printf 'E_RUNTIME_MISSING: loader is not installed\n' >&2; exit 1; }
  printf 'Verified global Codex integrated-harness fallback and loader.\n'
fi
