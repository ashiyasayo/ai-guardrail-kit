#!/usr/bin/env bash
set -euo pipefail
script_dir=$(cd "$(dirname "$0")" && pwd -P)
manager="$script_dir/codex-runtime-manager.py"
if [[ ! -f $manager && -n ${CODEX_HOME:-} && -f ${CODEX_HOME}/guardrail/bin/codex-runtime-manager.py ]]; then
  manager="${CODEX_HOME}/guardrail/bin/codex-runtime-manager.py"
fi
if [[ ! -f $manager ]]; then
  printf 'codex verify: runtime manager is unavailable; install the loader first\n' >&2
  exit 1
fi
python_bin=${AI_GUARDRAIL_PYTHON:-python3}
if ! "$python_bin" -c 'import sys; raise SystemExit(sys.version_info < (3, 9))' >/dev/null 2>&1; then python_bin=python; fi
export PYTHONUTF8=${PYTHONUTF8:-1}
expected=''
no_managed=0
if [[ ${1:-} == --no-managed-mode ]]; then no_managed=1; shift; fi
if (( no_managed )) && [[ $# -gt 0 && $1 != --* ]]; then exit 2; fi
if (( ! no_managed )) && [[ $# -gt 0 ]] && [[ $1 != --* ]]; then expected=$1; shift; fi
scope=project
offline=0
project='.'
while [[ $# -gt 0 ]]; do
  case $1 in
    --scope) [[ $# -ge 2 ]] || exit 2; scope=$2; shift 2;;
    --offline) offline=1; shift;;
    --) shift; [[ $# -le 1 ]] || exit 2; project=${1:-.}; shift;;
    -*) exit 2;;
    *) [[ $project == '.' ]] || exit 2; project=$1; shift;;
  esac
done
args=(verify --scope "$scope" --project "$project")
(( no_managed )) && args+=(--no-managed-mode)
[[ -n $expected ]] && args+=("$expected")
(( offline )) && args+=(--offline)
exec "$python_bin" "$manager" "${args[@]}"
