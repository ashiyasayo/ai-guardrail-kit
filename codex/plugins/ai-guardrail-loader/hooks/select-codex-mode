#!/usr/bin/env bash
set -euo pipefail

# Codex 模式切換只修改 project/local/user selector；不呼叫任何 legacy mode
# plugin add/remove。runtime manager 負責來源、驗證、cache 與 atomic commit。
script_dir=$(cd "$(dirname "$0")" && pwd -P)
manager="$script_dir/codex-runtime-manager.py"
if [[ ! -f $manager && -n ${CODEX_HOME:-} && -f ${CODEX_HOME}/guardrail/bin/codex-runtime-manager.py ]]; then
  manager="${CODEX_HOME}/guardrail/bin/codex-runtime-manager.py"
fi
if [[ ! -f $manager ]]; then
  printf 'codex mode: runtime manager is unavailable; install the loader first\n' >&2
  exit 1
fi
python_bin=${AI_GUARDRAIL_PYTHON:-}
if [[ -z $python_bin ]]; then
  if python3 -c 'import sys; raise SystemExit(sys.version_info < (3, 9))' >/dev/null 2>&1; then
    python_bin=python3
  elif python -c 'import sys; raise SystemExit(sys.version_info < (3, 9))' >/dev/null 2>&1; then
    python_bin=python
  else
    printf 'codex mode: Python 3.9+ is required\n' >&2
    exit 1
  fi
fi
export PYTHONUTF8=${PYTHONUTF8:-1}

usage() {
  printf 'usage: select-codex-mode [--update] <mode> [--scope project|local|user] [--ref <ref>] [--source github|local|test] [--offline] [project-dir]\n' >&2
  printf '       select-codex-mode --remove [--scope project|local|user] [project-dir]\n' >&2
}

update=0
remove=0
if [[ ${1:-} == --update ]]; then update=1; shift; fi
if [[ ${1:-} == --remove ]]; then
  (( update )) && { usage; exit 2; }
  remove=1; shift
fi
mode=${1:-}
if (( ! remove )); then
  case $mode in decomposition-gate|sensitive-data-guard|harness|integrated-harness) shift;; *) usage; exit 2;; esac
fi
scope=project
ref=''
source_name=''
owner=''
offline=0
project='.'
while [[ $# -gt 0 ]]; do
  case $1 in
    --scope) [[ $# -ge 2 ]] || { usage; exit 2; }; scope=$2; shift 2;;
    --ref) [[ $# -ge 2 ]] || { usage; exit 2; }; ref=$2; shift 2;;
    --source) [[ $# -ge 2 ]] || { usage; exit 2; }; source_name=$2; shift 2;;
    --owner) [[ $# -ge 2 && $2 == global-integrated-harness ]] || { usage; exit 2; }; owner=$2; shift 2;;
    --offline) offline=1; shift;;
    --) shift; [[ $# -le 1 ]] || { usage; exit 2; }; project=${1:-.}; shift;;
    -*) usage; exit 2;;
    *) [[ $project == '.' ]] || { usage; exit 2; }; project=$1; shift;;
  esac
done
case $scope in project|local|user) ;; *) usage; exit 2;; esac
args=()
if (( remove )); then
  args+=(remove)
else
  args+=(select "$mode")
  (( update )) && args+=(--update)
  (( offline )) && args+=(--offline)
  [[ -n $ref ]] && args+=(--ref "$ref")
  [[ -n $source_name ]] && args+=(--source "$source_name")
  [[ -n $owner ]] && args+=(--owner "$owner")
fi
(( remove )) && [[ -n $owner ]] && args+=(--owner "$owner")
args+=(--scope "$scope" --project "$project")
exec "$python_bin" "$manager" "${args[@]}"
